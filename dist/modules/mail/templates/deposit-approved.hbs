<!DOCTYPE html>
<html>
<body style="font-family: Arial, sans-serif; background: #f4f5f7; padding: 32px; margin: 0;">
  <table style="max-width: 480px; margin: 0 auto; background: #ffffff; border-radius: 8px; padding: 32px; border: 1px solid #e5e7eb;">
    <tr>
      <td>
        <div style="text-align: center; margin-bottom: 24px;">
          <h1 style="color: #111827; font-size: 22px; margin: 0 0 4px 0;">💰 Deposit Approved</h1>
        </div>

        <p style="color: #374151; font-size: 15px;">Hi {{firstName}},</p>
        <p style="color: #374151; font-size: 15px; line-height: 1.6;">
          Your recent fund deposit has been approved and credited to your wallet.
        </p>

        <div style="background: #f9fafb; border-radius: 8px; padding: 16px; margin: 24px 0; border: 1px solid #e5e7eb;">
          <table style="width: 100%; font-size: 14px;">
            <tr>
              <td style="color: #6b7280; padding-bottom: 8px;">Deposited Amount</td>
              <td style="color: #111827; font-weight: bold; text-align: right; padding-bottom: 8px;">{{amount}}</td>
            </tr>
            <tr>
              <td style="color: #6b7280; padding-bottom: 8px;">Date</td>
              <td style="color: #111827; font-weight: bold; text-align: right; padding-bottom: 8px;">{{depositDate}}</td>
            </tr>
            <tr>
              <td colspan="2"><hr style="border: none; border-top: 1px solid #e5e7eb; margin: 8px 0;" /></td>
            </tr>
            <tr>
              <td style="color: #6b7280; padding-top: 8px;"><strong>Total Wallet Balance</strong></td>
              <td style="color: #15803d; font-weight: bold; text-align: right; padding-top: 8px; font-size: 16px;">{{walletBalance}}</td>
            </tr>
          </table>
        </div>

        <p style="color: #374151; font-size: 15px; line-height: 1.6;">
          You can now invest in any scheme from your dashboard.
        </p>

        <p style="text-align: center; margin: 28px 0;">
          <a href="{{investLink}}" style="display: inline-block; background: #2563eb; color: #ffffff; text-decoration: none; padding: 12px 36px; border-radius: 6px; font-weight: bold; font-size: 15px;">
            View Investment Plans
          </a>
        </p>

        <hr style="border: none; border-top: 1px solid #e5e7eb; margin: 24px 0;" />
        <p style="color: #9ca3af; font-size: 12px; text-align: center; margin: 0;">
          &copy; {{year}} Pennytor. All rights reserved.
        </p>
      </td>
    </tr>
  </table>
</body>
</html>
