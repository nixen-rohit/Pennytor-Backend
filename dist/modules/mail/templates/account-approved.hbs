<!DOCTYPE html>
<html>
<body style="font-family: Arial, sans-serif; background: #f4f5f7; padding: 32px; margin: 0;">
  <table style="max-width: 480px; margin: 0 auto; background: #ffffff; border-radius: 8px; padding: 32px; border: 1px solid #e5e7eb;">
    <tr>
      <td>
        <!-- Header -->
        <div style="text-align: center; margin-bottom: 24px;">
          <h1 style="color: #111827; font-size: 22px; margin: 0 0 4px 0;">🎉 Congratulations!</h1>
          <p style="color: #6b7280; font-size: 14px; margin: 0;">Your Pennytor PMS Account is now Active</p>
        </div>

        <p style="color: #374151; font-size: 15px;">Hi {{firstName}},</p>
        <p style="color: #374151; font-size: 15px; line-height: 1.6;">
          We're thrilled to welcome you to <strong>Pennytor PMS</strong>! Your account has been reviewed and approved by our team.
        </p>

        <!-- Client ID Box -->
        <div style="background: #f0fdf4; border: 2px dashed #16a34a; border-radius: 8px; padding: 20px; text-align: center; margin: 24px 0;">
          <p style="color: #15803d; font-size: 13px; margin: 0 0 8px 0; font-weight: 600; text-transform: uppercase; letter-spacing: 1px;">Your Unique Client ID</p>
          <p style="font-size: 36px; font-weight: bold; letter-spacing: 8px; color: #111827; margin: 0;">{{clientId}}</p>
          <p style="color: #6b7280; font-size: 12px; margin: 8px 0 0 0;">Keep this safe — you'll need it for support and login.</p>
        </div>

        <!-- Next Steps -->
        <p style="color: #374151; font-size: 15px; font-weight: 600; margin-bottom: 8px;">Next Step: Complete Your KYC</p>
        <p style="color: #6b7280; font-size: 14px; line-height: 1.6; margin-top: 0;">
          To start investing, please complete your KYC verification. You will need to upload:
        </p>
        <ul style="color: #6b7280; font-size: 14px; line-height: 2; padding-left: 20px; margin: 0 0 24px 0;">
          <li>PAN Card</li>
          <li>Aadhaar Card</li>
          <li>Bank Details</li>
          <li>Photo / Selfie</li>
          <li>Signature</li>
          <li>Nominee Details</li>
        </ul>

        <!-- CTA Button -->
        <p style="text-align: center; margin: 28px 0;">
          <a href="{{kycLink}}" style="display: inline-block; background: #16a34a; color: #ffffff; text-decoration: none; padding: 12px 36px; border-radius: 6px; font-weight: bold; font-size: 15px;">
            Complete KYC Now
          </a>
        </p>

        <hr style="border: none; border-top: 1px solid #e5e7eb; margin: 24px 0;" />

        <p style="color: #9ca3af; font-size: 12px; text-align: center; margin: 0;">
          If you have any questions, contact our support team.<br/>
          &copy; {{year}} Pennytor. All rights reserved.
        </p>
      </td>
    </tr>
  </table>
</body>
</html>
