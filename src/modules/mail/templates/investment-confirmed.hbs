<!DOCTYPE html>
<html>
<body style="font-family: Arial, sans-serif; background: #f4f5f7; padding: 32px; margin: 0;">
  <table style="max-width: 480px; margin: 0 auto; background: #ffffff; border-radius: 8px; padding: 32px; border: 1px solid #e5e7eb;">
    <tr>
      <td>
        <div style="text-align: center; margin-bottom: 24px;">
          <h1 style="color: #111827; font-size: 22px; margin: 0 0 4px 0;">📈 Investment Confirmed</h1>
          <p style="color: #6b7280; font-size: 14px; margin: 0;">Congratulations on your investment!</p>
        </div>

        <p style="color: #374151; font-size: 15px;">Hi {{firstName}},</p>
        <p style="color: #374151; font-size: 15px; line-height: 1.6;">
          Your investment has been successfully confirmed. The amount has been deducted from your wallet balance.
        </p>

        <div style="background: #f9fafb; border-radius: 8px; padding: 16px; margin: 24px 0; border: 1px solid #e5e7eb;">
          <h3 style="margin-top: 0; color: #111827; font-size: 15px; border-bottom: 1px solid #e5e7eb; padding-bottom: 8px;">Plan Details</h3>
          <table style="width: 100%; font-size: 14px;">
            <tr>
              <td style="color: #6b7280; padding: 6px 0;">Plan Name</td>
              <td style="color: #111827; font-weight: bold; text-align: right;">{{planName}}</td>
            </tr>
            <tr>
              <td style="color: #6b7280; padding: 6px 0;">Investment Amount</td>
              <td style="color: #111827; font-weight: bold; text-align: right;">{{investmentAmount}}</td>
            </tr>
            <tr>
              <td style="color: #6b7280; padding: 6px 0;">Lock-in Period</td>
              <td style="color: #111827; font-weight: bold; text-align: right;">{{lockInPeriod}}</td>
            </tr>
            <tr>
              <td style="color: #6b7280; padding: 6px 0;">Annual Return</td>
              <td style="color: #15803d; font-weight: bold; text-align: right;">{{annualReturn}}</td>
            </tr>
            <tr>
              <td style="color: #6b7280; padding: 6px 0;">Expected Profit</td>
              <td style="color: #15803d; font-weight: bold; text-align: right;">{{expectedProfit}}</td>
            </tr>
            <tr>
              <td style="color: #6b7280; padding: 6px 0;">Date</td>
              <td style="color: #111827; font-weight: bold; text-align: right;">{{investmentDate}}</td>
            </tr>
          </table>
        </div>

        <p style="color: #374151; font-size: 14px; text-align: center;">
          Remaining Wallet Balance: <strong>{{walletBalance}}</strong>
        </p>

        <p style="text-align: center; margin: 28px 0;">
          <a href="{{dashboardLink}}" style="display: inline-block; background: #16a34a; color: #ffffff; text-decoration: none; padding: 12px 36px; border-radius: 6px; font-weight: bold; font-size: 15px;">
            View in Dashboard
          </a>
        </p>

        <hr style="border: none; border-top: 1px solid #e5e7eb; margin: 24px 0;" />
        <p style="color: #9ca3af; font-size: 12px; text-align: center; margin: 0;">
          &copy; {{year}} Pennytor. All rights reserved.
        </p>
      </td>
    </tr>
  </table>
</body>
</html>
