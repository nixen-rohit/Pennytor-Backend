<!DOCTYPE html>
<html>
<body style="font-family: Arial, sans-serif; background: #f4f5f7; padding: 32px; margin: 0;">
  <table style="max-width: 480px; margin: 0 auto; background: #ffffff; border-radius: 8px; padding: 32px; border: 1px solid #e5e7eb;">
    <tr>
      <td>
        <div style="text-align: center; margin-bottom: 24px;">
          <h1 style="color: #111827; font-size: 22px; margin: 0 0 4px 0;">🚀 Investment Approved</h1>
          <p style="color: #6b7280; font-size: 13px; margin: 0;">Your ROI cycle has started</p>
        </div>

        <p style="color: #374151; font-size: 15px;">Hi {{firstName}},</p>
        <p style="color: #374151; font-size: 15px; line-height: 1.6;">
          Your investment application has been reviewed and approved by our team.
          Here is a copy of your investment details:
        </p>

        <div style="background: #f9fafb; border-radius: 8px; padding: 16px; margin: 24px 0; border: 1px solid #e5e7eb;">
          <table style="width: 100%; font-size: 14px;">
            <tr>
              <td style="color: #6b7280; padding-bottom: 8px;">Scheme</td>
              <td style="color: #111827; font-weight: bold; text-align: right; padding-bottom: 8px;">{{planName}}</td>
            </tr>
            <tr>
              <td style="color: #6b7280; padding-bottom: 8px;">Invested Amount</td>
              <td style="color: #111827; font-weight: bold; text-align: right; padding-bottom: 8px;">{{amount}}</td>
            </tr>
            <tr>
              <td style="color: #6b7280; padding-bottom: 8px;">Monthly ROI</td>
              <td style="color: #15803d; font-weight: bold; text-align: right; padding-bottom: 8px;">{{monthlyRoi}} ({{roiPercent}})</td>
            </tr>
            <tr>
              <td style="color: #6b7280; padding-bottom: 8px;">Lock-in Period</td>
              <td style="color: #111827; font-weight: bold; text-align: right; padding-bottom: 8px;">{{lockInPeriod}}</td>
            </tr>
            <tr>
              <td colspan="2"><hr style="border: none; border-top: 1px solid #e5e7eb; margin: 8px 0;" /></td>
            </tr>
            <tr>
              <td style="color: #6b7280; padding-top: 8px; padding-bottom: 8px;">Cycle Start Date</td>
              <td style="color: #111827; font-weight: bold; text-align: right; padding-top: 8px; padding-bottom: 8px;">{{cycleStartDate}}</td>
            </tr>
            <tr>
              <td style="color: #6b7280; padding-bottom: 8px;">First ROI Credit</td>
              <td style="color: #111827; font-weight: bold; text-align: right; padding-bottom: 8px;">{{nextPayoutDate}}</td>
            </tr>
            <tr>
              <td style="color: #6b7280;"><strong>Maturity Date</strong></td>
              <td style="color: #111827; font-weight: bold; text-align: right;">{{maturityDate}}</td>
            </tr>
          </table>
        </div>

        <p style="color: #374151; font-size: 14px; line-height: 1.6;">
          Your monthly return of <strong style="color: #15803d;">{{monthlyRoi}}</strong> will be credited
          to your wallet automatically every month on this same date.
        </p>

        <p style="text-align: center; margin: 28px 0;">
          <a href="{{dashboardLink}}" style="display: inline-block; background: #2563eb; color: #ffffff; text-decoration: none; padding: 12px 36px; border-radius: 6px; font-weight: bold; font-size: 15px;">
            View My Investments
          </a>
        </p>

        <hr style="border: none; border-top: 1px solid #e5e7eb; margin: 24px 0;" />
        <p style="color: #9ca3af; font-size: 12px; text-align: center; margin: 0;">
          &copy; {{year}} Pennytor. All rights reserved.
        </p>
      </td>
    </tr>
  </table>
</body>
</html>
