generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  LOCKED
  SUSPENDED
  DELETED
}

enum Role {
  USER
  ADMIN
}

enum OtpPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
  LOGIN_MFA
  KYC_SUBMIT
  WITHDRAW_SUBMIT
}

enum AuditAction {
  REGISTER
  REGISTER_FAILED
  EMAIL_VERIFIED
  OTP_RESENT
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  LOGOUT_ALL
  TOKEN_REFRESHED
  TOKEN_REUSE_DETECTED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_CHANGED
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED

  // Admin finance decisions (actor recorded in AuditLog.userId)
  APPROVE_DEPOSIT
  REJECT_DEPOSIT
  APPROVE_WITHDRAWAL
  REJECT_WITHDRAWAL
  APPROVE_INVESTMENT_FUND
  REJECT_INVESTMENT_FUND

  // System ROI credit (actor omitted — cron-driven)
  INVESTMENT_ROI_CREDIT
}

enum KycApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum KycFileType {
  SELFIE
  AADHAAR_FRONT
  AADHAAR_BACK
  PAN
  SIGNATURE
}

enum KycFileAuditAction {
  VIEW
  DOWNLOAD
  DELETE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum AccountType {
  SAVINGS
  CURRENT
  SALARY
}

model User {
  id           String     @id @default(uuid())
  firstName    String
  lastName     String
  email        String     @unique
  passwordHash String

  emailVerified Boolean    @default(false)
  status        UserStatus @default(PENDING_VERIFICATION)
  role          Role       @default(USER)

  ownReferralCode String  @unique
  referredBy      String?

  clientId   String?   @unique
  isApproved Boolean   @default(false)

  // Real-time wallet balance (INR). Credited when an admin approves a
  // deposit request; debited on approved withdrawals.
  balance Decimal @default(0) @db.Decimal(12, 2)

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consent               UserConsent?
  otps                  Otp[]
  passwordResetTokens   PasswordResetToken[]
  sessions              Session[]
  auditLogs             AuditLog[]
  kycApplication        KycApplication?
  deposits              DepositRequest[]
  withdrawals           WithdrawalRequest[]
  investmentApplications InvestmentApplication[]
  investmentRoiPayouts   InvestmentRoiPayout[]
  ledgerEntries         LedgerEntry[]

  @@index([email])
  @@map("users")
}

// One KYC application per user. Re-submission after a rejection updates the
// same row (DRAFT again), so the application id — and therefore the private
// storage directory — is stable across attempts.
//
// Sensitive values (aadhaarNumber, accountNumber, nomineeAadhaar) are stored
// AES-256-GCM encrypted via EncryptionService; this table never holds their
// plaintext.
model KycApplication {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status KycApplicationStatus @default(DRAFT)

  // Step 1 — Personal information
  fullName      String
  phone         String
  dob           DateTime
  gender        Gender?
  maritalStatus MaritalStatus?

  // Step 2 — Aadhaar / PAN. Identifiers are AES-256-GCM ciphertext at rest;
  // the ciphertext is decrypted ONLY for an ADMIN on the review-detail
  // endpoint, because verification needs the full numbers. The last-4
  // plaintext digits power the user-facing masks. Nullable: rows created
  // before this layer cannot be retro-fitted.
  aadhaarNumberEncrypted String?
  aadhaarNumberLast4     String
  panNumberEncrypted     String?
  panNumberLast4         String

  // Step 3 — Bank details (same scheme as step 2)
  accountHolderName      String
  accountNumberEncrypted String?
  accountNumberLast4     String
  ifscCodeEncrypted      String?
  ifscCodeLast4          String
  bankName               String
  branchName             String
  accountType            AccountType?
  branchAddress          String?

  // Step 4 — Nominee (same scheme as step 2)
  nomineeName             String
  nomineeDob              DateTime
  nomineePhone            String?
  nomineeAadhaarEncrypted String?
  nomineeAadhaarLast4     String

  submittedAt DateTime?
  reviewedBy  String?
  reviewedAt  DateTime?
  reviewNote  String?

  files KycFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId])
  @@index([status])
  @@index([createdAt])
  @@map("kyc_applications")
}

// File metadata ONLY. Actual bytes live on the VPS filesystem under
// PRIVATE_STORAGE_PATH/kyc/<applicationId>/ and are never served publicly —
// they are streamed through the authenticated admin API.
//
// storagePath is RELATIVE to PRIVATE_STORAGE_PATH (e.g. `kyc/<appId>/<name>`)
// so it can never be abused as an absolute path, and the frontend is never
// given it.
//
// @@unique([applicationId, type]) enforces a single file per type per
// application: uploading the same type again explicitly replaces it.
model KycFile {
  id            String @id @default(uuid())
  applicationId String
  application   KycApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  type KycFileType

  originalName String
  storageName  String
  storagePath  String
  mimeType     String
  fileSize     Int

  auditLogs KycFileAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([applicationId, type])
  @@index([applicationId])
  @@map("kyc_files")
}

// Every admin access to a private KYC document is recorded here:
// VIEW / DOWNLOAD / DELETE, with the acting admin and request context.
model KycFileAuditLog {
  id     String @id @default(uuid())
  fileId String?
  file   KycFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  // Snapshot taken at audit time — the row stays meaningful even after the
  // file itself is deleted (fileId then becomes null).
  fileType    KycFileType
  storagePath String

  adminId     String
  action      KycFileAuditAction
  ipAddress   String?
  userAgent   String?

  createdAt DateTime @default(now())

  @@index([fileId])
  @@index([adminId])
  @@index([action])
  @@map("kyc_file_audit_logs")
}

enum DepositStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

// A user-submitted fund deposit request with its single payment-screenshot.
// The screenshot bytes live on the VPS filesystem under
// PRIVATE_STORAGE_PATH/deposits/<requestId>/ and are only ever streamed
// through the authenticated admin API — never served publicly.
model DepositRequest {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount        Decimal       @db.Decimal(12, 2)
  transactionId String
  status        DepositStatus @default(PENDING)

  reviewNote String?
  reviewedBy String?
  reviewedAt DateTime?
  submittedAt DateTime? @default(now())

  originalName String
  storageName  String
  storagePath  String
  mimeType     String
  fileSize     Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([submittedAt])
  @@map("deposit_requests")
}

enum WithdrawalStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum ContactMessageStatus {
  NEW
  IN_PROGRESS
  DONE
}

model ContactMessage {
  id        String              @id @default(uuid())
  name      String
  email     String
  phone     String
  service   String?
  message   String
  status    ContactMessageStatus @default(NEW)
  reviewNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("contact_messages")
}

// A user-submitted withdrawal request to their registered bank account or a
// UPI ID. The wallet is debited ONLY when an admin approves (VERIFIED) — the
// same transactional, idempotent pattern as deposit crediting. REJECTED
// requires a reason, which is shown to the user.
model WithdrawalRequest {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount      Decimal          @db.Decimal(12, 2)
  method      String
  destination String
  status      WithdrawalStatus @default(PENDING)

  reviewNote String?
  reviewedBy String?
  reviewedAt DateTime?
  submittedAt DateTime? @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([submittedAt])
  @@map("withdrawal_requests")
}

enum InvestmentScheme {
  A
  B
  C
  D
  E
}

enum InvestmentStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

// A user-submitted investment fund application. The wallet is debited
// IMMEDIATELY upon submission; admin approval (VERIFIED) finalizes it and
// STARTS the ROI cycle (verifiedAt), rejection (REJECTED) refunds the wallet.
model InvestmentApplication {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  scheme      InvestmentScheme
  amount      Decimal          @db.Decimal(12, 2)
  method      String
  destination String
  status      InvestmentStatus @default(PENDING)

  reviewNote String?
  reviewedBy String?
  reviewedAt DateTime?
  submittedAt DateTime? @default(now())

  // ROI cycle — set together by admin approval. verifiedAt starts both the
  // lock-in period and monthly ROI accrual; lastRoiPaidAt is the moment up
  // to which every elapsed month has already been credited.
  verifiedAt   DateTime?
  lastRoiPaidAt DateTime?

  roiPayouts InvestmentRoiPayout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([submittedAt])
  @@index([verifiedAt])
  @@map("investment_applications")
}

// One row per credited ROI month. Immutable money trail for the auto-credit
// job; periodStart/periodEnd make each payout auditable down to its cycle.
model InvestmentRoiPayout {
  id            String   @id @default(uuid())
  applicationId String
  application   InvestmentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount       Decimal @db.Decimal(12, 2)
  roiPercent   Decimal @db.Decimal(5, 2)
  periodStart  DateTime
  periodEnd    DateTime

  createdAt DateTime @default(now())

  @@index([applicationId])
  @@index([userId, createdAt])
  @@map("investment_roi_payouts")
}

// Immutable record of money that actually moved. A deposit/withdrawal REQUEST
// is the user's ask; only an admin approval creates the corresponding ledger
// entry (credit for deposits, debit for withdrawals) inside the same DB
// transaction that flips the request status — the balance and the ledger can
// never diverge. Rejections move no money and create no entry.
enum LedgerDirection {
  CREDIT
  DEBIT
}

enum LedgerSourceType {
  DEPOSIT
  WITHDRAWAL
  WITHDRAWAL_REFUND
  INVESTMENT_REFUND
  INVESTMENT_ROI
}

model LedgerEntry {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  direction   LedgerDirection
  amount      Decimal @db.Decimal(12, 2)
  balanceAfter Decimal @db.Decimal(12, 2)

  // Which request this entry settles (no FK: deposits and withdrawals live
  // in different tables).
  sourceType LedgerSourceType
  sourceId   String

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([sourceType, sourceId])
  @@map("ledger_entries")
}
model UserConsent {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  termsAccepted           Boolean   @default(false)
  termsAcceptedAt         DateTime?
  privacyPolicyAccepted   Boolean   @default(false)
  privacyPolicyAcceptedAt DateTime?
  marketingEmails         Boolean   @default(false)

  createdAt DateTime @default(now())

  @@map("user_consents")
}

model Otp {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose     OtpPurpose

  otpHash     String
  expiresAt   DateTime
  attempts    Int      @default(0)
  maxAttempts Int      @default(5)
  consumedAt  DateTime?

  createdAt DateTime @default(now())

  @@index([userId, purpose])
  @@map("otps")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model Session {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String   @unique
  expiresAt DateTime

  deviceLabel String?
  ipAddress   String?
  userAgent   String?

  lastActiveAt DateTime @default(now())
  revokedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model AuditLog {
  id     String @id @default(uuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action    AuditAction
  ipAddress String?
  userAgent String?
  metadata  Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}
