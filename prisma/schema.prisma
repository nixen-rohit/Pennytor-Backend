generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  LOCKED
  SUSPENDED
  DELETED
}

enum Role {
  USER
  ADMIN
}

enum OtpPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
  LOGIN_MFA
  KYC_SUBMIT
  WITHDRAW_SUBMIT
}

enum AuditAction {
  REGISTER
  REGISTER_FAILED
  EMAIL_VERIFIED
  OTP_RESENT
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  LOGOUT_ALL
  TOKEN_REFRESHED
  TOKEN_REUSE_DETECTED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_CHANGED
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED

  // Admin finance decisions (actor recorded in AuditLog.userId)
  APPROVE_DEPOSIT
  REJECT_DEPOSIT
  APPROVE_WITHDRAWAL
  REJECT_WITHDRAWAL
  APPROVE_INVESTMENT_FUND
  REJECT_INVESTMENT_FUND

  // System ROI credit (actor omitted — cron-driven)
  INVESTMENT_ROI_CREDIT

  // SIP For Child
  APPROVE_SIP_FOR_CHILD
  REJECT_SIP_FOR_CHILD
  SIP_PREMIUM_PAID
  SIP_FOR_CHILD_AUTO_REJECTED

  // Referral
  REFERRAL_CODE_GENERATED
  REFERRAL_CODE_ACTIVATED
  REFERRAL_CODE_DEACTIVATED
  REFERRAL_COMMISSION_CALCULATED
  REFERRAL_COMMISSION_PAID
  REFERRAL_COMMISSION_FROZEN
  REFERRAL_COMMISSION_REVERSED
}

enum KycApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum KycFileType {
  SELFIE
  AADHAAR_FRONT
  AADHAAR_BACK
  PAN
  SIGNATURE
}

enum KycFileAuditAction {
  VIEW
  DOWNLOAD
  DELETE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum AccountType {
  SAVINGS
  CURRENT
  SALARY
}

enum SIPStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum SIPPlanId {
  PLAN_5000
  PLAN_2500
}

// ─── Referral & Commission ────────────────────────────────────────────────

enum UserType {
  pennytor_user
  super_user
}

// Per spec §3: codes carry an explicit status. `null` = never issued.
enum ReferralCodeStatus {
  ACTIVE
  INACTIVE
}

// Per spec §20: commission record is the single source of truth for the
// moment it was calculated. Status transitions are explicit and audited.
enum CommissionStatus {
  CALCULATED
  PAID
  FROZEN
  REVERSED
}

// Per spec §7: L1–L5 commission configuration. Persisted so it can change
// without affecting already-paid historical snapshots.
model CommissionLevelConfig {
  id                  Int      @id @default(1)
  l1RatePercent       Decimal  @db.Decimal(5, 4) // 0.50 = 0.50%
  l2RatePercent       Decimal  @db.Decimal(5, 4)
  l3RatePercent       Decimal  @db.Decimal(5, 4)
  l4RatePercent       Decimal  @db.Decimal(5, 4)
  l5RatePercent       Decimal  @db.Decimal(5, 4)
  l2MinDirectVerified Int      @default(3)
  l3MinDirectVerified Int      @default(6)
  l4MinDirectVerified Int      @default(9)
  l5MinDirectVerified Int      @default(12)
  maxDepth            Int      @default(5)
  active              Boolean  @default(true)
  updatedAt           DateTime @updatedAt

  @@map("commission_level_config")
}

model User {
  id           String @id @default(uuid())
  firstName    String
  lastName     String
  email        String @unique
  passwordHash String

  emailVerified Boolean    @default(false)
  status        UserStatus @default(PENDING_VERIFICATION)
  role          Role       @default(USER)
  userType      UserType   @default(pennytor_user)

  // ─── Referral fields (spec §2, §3, §7) ────────────────────────────────
  // Initially NULL — code is generated ONLY after a verified investment.
  referralCode       String?             @unique
  referralCodeStatus ReferralCodeStatus?
  // Spec §1: SUPER_USER may have referredById = null. ADMIN is excluded by
  // explicit `role === ADMIN` checks, never by null-checks alone.
  referredById       String?
  // Legacy, kept for backward compat (read-only helper for admin views).
  referralEligible   Boolean             @default(true)

  referredByUser User?  @relation("ReferralChain", fields: [referredById], references: [id])
  referrals      User[] @relation("ReferralChain")

  // Outgoing relationships (this user is the referrer).
  referrerRelationships ReferralRelationship[] @relation("ReferrerSide")
  // Incoming relationship (this user is the referred).
  referredRelationship  ReferralRelationship?  @relation("ReferredSide")

  clientId   String? @unique
  isApproved Boolean @default(false)

  // Real-time wallet balance (INR). Credited when an admin approves a
  // deposit request; debited on approved withdrawals.
  balance Decimal @default(0) @db.Decimal(12, 2)

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consent                  UserConsent?
  otps                     Otp[]
  passwordResetTokens      PasswordResetToken[]
  sessions                 Session[]
  auditLogs                AuditLog[]
  kycApplication           KycApplication?
  deposits                 DepositRequest[]
  withdrawals              WithdrawalRequest[]
  investmentApplications   InvestmentApplication[]
  investmentRoiPayouts     InvestmentRoiPayout[]
  ledgerEntries            LedgerEntry[]
  sipForChildApplications  SIPForChildApplication[]
  fixedDepositApplications FixedDepositApplication[]
  fixedDepositPayouts      FixedDepositPayout[]

  // Referral commissions earned (this user is the referrer).
  referralCommissions       ReferralCommission[] @relation("CommissionReferrer")
  // Referral commissions generated by this user's investments (this user
  // is the referred — the source side of the calculation).
  referralCommissionsOnUser ReferralCommission[] @relation("CommissionReferred")
  SIPForChildPremium        SIPForChildPremium[]

  @@index([email])
  @@index([referredById])
  @@index([role, status])
  @@map("users")
}

// Spec §7: store only DIRECT relationships, compute depth dynamically.
// `referredUserId` is UNIQUE → a user can have at most one direct referrer.
// Self-reference is blocked at the DB level (CHECK constraint enforced via
// migration in addition to service-level checks).
model ReferralRelationship {
  id             String   @id @default(uuid())
  referrerId     String
  referrer       User     @relation("ReferrerSide", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUserId String   @unique
  referred       User     @relation("ReferredSide", fields: [referredUserId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@index([referrerId])
  @@index([createdAt])
  @@map("referral_relationships")
}

// Spec §20: immutable snapshot of a single commission event.
// Once inserted, no field is ever updated (other than status transitions
// for admin freeze/reverse, which create separate reversal rows).
model ReferralCommission {
  id                            String              @id @default(uuid())
  referrerId                    String
  referrer                      User                @relation("CommissionReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUserId                String
  referred                      User                @relation("CommissionReferred", fields: [referredUserId], references: [id], onDelete: Cascade)
  investmentId                  String
  level                         Int // 1..5
  investmentAmountSnapshot      Decimal             @db.Decimal(12, 2)
  commissionRateSnapshot        Decimal             @db.Decimal(5, 4) // percent (0.5 = 0.5%)
  qualifyingDirectReferralCount Int
  commissionAmount              Decimal             @db.Decimal(12, 2)
  commissionMonth               Int
  commissionYear                Int
  status                        CommissionStatus    @default(CALCULATED)
  paidAt                        DateTime?
  frozenAt                      DateTime?
  reversedAt                    DateTime?
  reversalOfId                  String?             @unique
  reversalOf                    ReferralCommission? @relation("Reversal", fields: [reversalOfId], references: [id])
  reversal                      ReferralCommission? @relation("Reversal")
  createdAt                     DateTime            @default(now())

  // Spec §8 idempotency: never pay the same commission twice.
  // The unique combination freezes the (referrer, referred, investment, level,
  // month, year) tuple — a duplicate scheduler run cannot insert a second row.
  @@unique([referrerId, referredUserId, investmentId, level, commissionMonth, commissionYear], name: "referral_commission_idempotency")
  @@index([referrerId, createdAt])
  @@index([referredUserId])
  @@index([status])
  @@index([commissionYear, commissionMonth])
  @@map("referral_commissions")
}

model ReferralCommissionRecord {
  id           String   @id @default(uuid())
  commissionId String
  amount       Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  @@unique([commissionId])
  @@map("referral_commission_records")
}

model KycApplication {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status KycApplicationStatus @default(DRAFT)

  // Step 1 — Personal information
  fullName      String
  phone         String
  dob           DateTime
  gender        Gender?
  maritalStatus MaritalStatus?

  aadhaarNumberEncrypted String?
  aadhaarNumberLast4     String
  panNumberEncrypted     String?
  panNumberLast4         String

  accountHolderName      String
  accountNumberEncrypted String?
  accountNumberLast4     String
  ifscCodeEncrypted      String?
  ifscCodeLast4          String
  bankName               String
  branchName             String
  accountType            AccountType?
  branchAddress          String?

  nomineeName             String
  nomineeDob              DateTime
  nomineePhone            String?
  nomineeAadhaarEncrypted String?
  nomineeAadhaarLast4     String

  submittedAt DateTime?
  reviewedBy  String?
  reviewedAt  DateTime?
  reviewNote  String?

  files KycFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId])
  @@index([status])
  @@index([createdAt])
  @@map("kyc_applications")
}

model KycFile {
  id            String         @id @default(uuid())
  applicationId String
  application   KycApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  type KycFileType

  originalName String
  storageName  String
  storagePath  String
  mimeType     String
  fileSize     Int

  auditLogs KycFileAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([applicationId, type])
  @@index([applicationId])
  @@map("kyc_files")
}

model KycFileAuditLog {
  id     String   @id @default(uuid())
  fileId String?
  file   KycFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  fileType    KycFileType
  storagePath String

  adminId   String
  action    KycFileAuditAction
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([fileId])
  @@index([adminId])
  @@index([action])
  @@map("kyc_file_audit_logs")
}

enum DepositStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

model DepositRequest {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount        Decimal       @db.Decimal(12, 2)
  transactionId String
  status        DepositStatus @default(PENDING)

  reviewNote  String?
  reviewedBy  String?
  reviewedAt  DateTime?
  submittedAt DateTime? @default(now())

  originalName String
  storageName  String
  storagePath  String
  mimeType     String
  fileSize     Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([transactionId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([submittedAt])
  @@map("deposit_requests")
}

enum WithdrawalStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum ContactMessageStatus {
  NEW
  IN_PROGRESS
  DONE
}

model ContactMessage {
  id         String               @id @default(uuid())
  name       String
  email      String
  phone      String
  service    String?
  message    String
  status     ContactMessageStatus @default(NEW)
  reviewNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("contact_messages")
}

model WithdrawalRequest {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount      Decimal          @db.Decimal(12, 2)
  method      String
  destination String
  status      WithdrawalStatus @default(PENDING)

  reviewNote  String?
  reviewedBy  String?
  reviewedAt  DateTime?
  submittedAt DateTime? @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([submittedAt])
  @@map("withdrawal_requests")
}

enum InvestmentScheme {
  A
  B
  C
  D
  E
}

enum InvestmentStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  CANCELLED
  COMPLETED
}

model InvestmentApplication {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  scheme      InvestmentScheme
  amount      Decimal          @db.Decimal(12, 2)
  method      String
  destination String
  status      InvestmentStatus @default(PENDING)

  reviewNote  String?
  reviewedBy  String?
  reviewedAt  DateTime?
  submittedAt DateTime? @default(now())

  verifiedAt    DateTime?
  lastRoiPaidAt DateTime?

  roiPayouts InvestmentRoiPayout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([submittedAt])
  @@index([verifiedAt])
  @@map("investment_applications")
}

model SIPForChildApplication {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  scheme      SIPPlanId
  amount      Decimal   @db.Decimal(12, 2)
  method      String
  destination String
  status      SIPStatus @default(PENDING)

  reviewNote  String?
  reviewedBy  String?
  reviewedAt  DateTime?
  submittedAt DateTime? @default(now())

  totalMonths    Int       @default(120)
  monthsPaid     Int       @default(0)
  monthsMissed   Int       @default(0)
  nextPaymentDue DateTime?
  startedAt      DateTime?
  lastPaidAt     DateTime?

  verifiedAt DateTime?

  premiums SIPForChildPremium[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([submittedAt])
  @@index([verifiedAt])
  @@map("sip_for_child_applications")
}

model SIPForChildPremium {
  id            String                 @id @default(uuid())
  applicationId String
  application   SIPForChildApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  userId        String
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount      Decimal   @db.Decimal(12, 2)
  monthNumber Int
  status      String    @default("PAID")
  paidAt      DateTime?

  createdAt DateTime @default(now())

  @@unique([applicationId, monthNumber], name: "sip_premium_app_month_unique")
  @@index([applicationId])
  @@index([userId, createdAt])
  @@map("sip_for_child_premiums")
}

model InvestmentRoiPayout {
  id            String                @id @default(uuid())
  applicationId String
  application   InvestmentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  userId        String
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount      Decimal  @db.Decimal(12, 2)
  roiPercent  Decimal  @db.Decimal(5, 2)
  periodStart DateTime
  periodEnd   DateTime

  createdAt DateTime @default(now())

  @@index([applicationId])
  @@index([userId, createdAt])
  @@map("investment_roi_payouts")
}

// ─── Fixed Deposit (with SWP) ────────────────────────────────────────────────

enum FixedDepositPlanId {
  FD_25000
  FD_50000
  FD_100000
}

enum FixedDepositStatus {
  PENDING
  VERIFIED
  COMPLETED
  REJECTED
}

enum FixedDepositPayoutStatus {
  PENDING
  PAID
}

model FixedDepositApplication {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  planId        FixedDepositPlanId
  depositAmount Decimal            @db.Decimal(12, 2)
  lockInMonths  Int
  payoutMode    String
  emiAmount     Decimal            @db.Decimal(12, 2)
  totalEmis     Int
  totalPayout   Decimal            @db.Decimal(12, 2)

  status      FixedDepositStatus @default(PENDING)
  reviewNote  String?
  reviewedBy  String?
  reviewedAt  DateTime?
  submittedAt DateTime?          @default(now())

  verifiedAt   DateTime?
  nextPayoutAt DateTime?
  emisPaid     Int       @default(0)
  lastPayoutAt DateTime?

  payouts FixedDepositPayout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([status, nextPayoutAt])
  @@index([createdAt])
  @@map("fixed_deposit_applications")
}

model FixedDepositPayout {
  id            String                  @id @default(uuid())
  applicationId String
  application   FixedDepositApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  userId        String
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  emiNumber Int
  amount    Decimal                  @db.Decimal(12, 2)
  status    FixedDepositPayoutStatus @default(PENDING)
  paidAt    DateTime?

  createdAt DateTime @default(now())

  @@unique([applicationId, emiNumber])
  @@index([applicationId])
  @@index([userId])
  @@index([status])
  @@map("fixed_deposit_payouts")
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

enum LedgerSourceType {
  DEPOSIT
  WITHDRAWAL
  WITHDRAWAL_REFUND
  INVESTMENT_REFUND
  INVESTMENT_ROI
  SIP_FOR_CHILD
  SIP_FOR_CHILD_REFUND
  FD_DEPOSIT
  FD_PAYOUT
  // Spec §7: ledger entries for referral commission + reversals.
  REFERRAL_COMMISSION
  REFERRAL_COMMISSION_REVERSAL
}

model LedgerEntry {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  direction    LedgerDirection
  amount       Decimal         @db.Decimal(12, 2)
  balanceAfter Decimal         @db.Decimal(12, 2)

  sourceType LedgerSourceType
  sourceId   String

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([sourceType, sourceId])
  @@map("ledger_entries")
}

model UserConsent {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  termsAccepted           Boolean   @default(false)
  termsAcceptedAt         DateTime?
  privacyPolicyAccepted   Boolean   @default(false)
  privacyPolicyAcceptedAt DateTime?
  marketingEmails         Boolean   @default(false)

  createdAt DateTime @default(now())

  @@map("user_consents")
}

model Otp {
  id      String     @id @default(uuid())
  userId  String
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose OtpPurpose

  otpHash     String
  expiresAt   DateTime
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  consumedAt  DateTime?

  createdAt DateTime @default(now())

  @@index([userId, purpose])
  @@map("otps")
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model Session {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String   @unique
  expiresAt DateTime

  deviceLabel String?
  ipAddress   String?
  userAgent   String?

  lastActiveAt DateTime  @default(now())
  revokedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model AuditLog {
  id     String  @id @default(uuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action    AuditAction
  ipAddress String?
  userAgent String?
  metadata  Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
