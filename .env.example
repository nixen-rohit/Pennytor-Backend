# Environment Configuration Template
# Copy this file to .env and fill in the actual values
# NEVER commit .env to version control

NODE_ENV=development
PORT=3001

# Database - PostgreSQL connection string
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/pennytor_dev"

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Session lifetime in days
SESSION_TTL_DAYS=30

# CSRF secret - generate with: openssl rand -hex 32
# MUST be 32 bytes (64 hex characters) for HMAC-SHA256
CSRF_SECRET=CHANGE_ME_TO_64_CHAR_HEX_STRING

# OTP Configuration
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=6

# Brevo (Sendinblue) Email API Key
# Get from: https://app.brevo.com/settings/keys
BREVO_API_KEY=CHANGE_ME_TO_YOUR_BREVO_API_KEY
MAIL_FROM=no-reply@yourdomain.com
MAIL_FROM_NAME=PennyTor

# Rate Limiting (requests per 60 seconds)
THROTTLE_TTL_SECONDS=60
THROTTLE_DEFAULT_LIMIT=120
THROTTLE_AUTH_LIMIT=20
THROTTLE_REGISTER_LIMIT=10
THROTTLE_PASSWORD_RESET_LIMIT=10
THROTTLE_REFERRAL_LIMIT=100
THROTTLE_ADMIN_LIMIT=200
THROTTLE_FINANCIAL_LIMIT=60

# Password Reset Token Expiry (minutes)
PASSWORD_RESET_EXPIRY_MINUTES=15

# KYC Document Storage
# Development: ./private-storage
# Production: /var/private-storage or cloud storage path
PRIVATE_STORAGE_PATH=./private-storage
KYC_UPLOAD_MAX_MB=2

# Data Encryption Key for sensitive fields (AES-256-GCM)
# Generate with: openssl rand -hex 32
DATA_ENCRYPTION_KEY=CHANGE_ME_TO_32_BYTE_HEX_STRING
