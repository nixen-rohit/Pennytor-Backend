NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://user:password@localhost:5432/pennytor?schema=public

FRONTEND_URL=http://localhost:3000

BCRYPT_SALT_ROUNDS=12

OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=6

BREVO_API_KEY=bravo email key
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USER=your-brevo-login-email@example.com
MAIL_PASSWORD=your-brevo-smtp-key
MAIL_FROM=no-reply@pennytor.com



THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=10

JWT_ACCESS_SECRET=replace-with-output-of-openssl-rand-base64-64
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_DAYS=30
PASSWORD_RESET_EXPIRY_MINUTES=15
