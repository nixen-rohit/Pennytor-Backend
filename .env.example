NODE_ENV=development
PORT=3001

DATABASE_URL="postgresql://user:password@localhost:5432/pennytor"

FRONTEND_URL=http://localhost:3000

BCRYPT_SALT_ROUNDS=12

OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=6

BREVO_API_KEY=your-brevo-api-key
MAIL_FROM=no-reply@pennytor.com
MAIL_FROM_NAME=Pennytor

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=10

JWT_ACCESS_SECRET=replace-with-output-of-openssl-rand-base64-64
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_DAYS=30
PASSWORD_RESET_EXPIRY_MINUTES=15

# Manually-created admin account (see `npm run db:seed`)
# The admin gets its own generated referral code, like any user.
ADMIN_EMAIL=admin@pennytor.com
ADMIN_PASSWORD=Admin@1234
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=Pennytor
