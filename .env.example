NODE_ENV=development
PORT=3001

DATABASE_URL="postgresql://user:password@localhost:5432/pennytor"

FRONTEND_URL=http://localhost:3000

# Server-side session lifetime in days. The HttpOnly `sid` cookie maxAge
# is derived from this so both always expire together.
SESSION_TTL_DAYS=30

# HMAC key signing CSRF tokens — generate with: openssl rand -hex 32
CSRF_SECRET=replace-with-64-hex-chars-from-openssl-rand-hex-32

OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=6

BREVO_API_KEY=your-brevo-api-key
MAIL_FROM=no-reply@pennytor.com
MAIL_FROM_NAME=Pennytor

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=10

PASSWORD_RESET_EXPIRY_MINUTES=15

# Private KYC document store. NEVER exposed by Nginx — served only through
# the authenticated admin API. Production: /var/private-storage
PRIVATE_STORAGE_PATH=/var/private-storage

# AES-256-GCM key for sensitive KYC fields (aadhaar, account number, nominee aadhaar).
# Generate with: openssl rand -hex 32   (keep this secret, never commit it)
DATA_ENCRYPTION_KEY=replace-with-64-hex-chars-from-openssl-rand-hex-32

# Hard cap for a single uploaded KYC document (MB)
KYC_UPLOAD_MAX_MB=2